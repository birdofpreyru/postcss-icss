{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "paths": {
      "*": ["./*"]
    },
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
